{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resourcehub.net/schemas/people.schema.json",
  "title": "resourcehub.net people entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "affiliation",
    "focus",
    "links",
    "start_here",
    "why"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "affiliation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "focus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "links": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "site": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "x": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "github": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "newsletter": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "youtube": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "scholar": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        }
      }
    },
    "start_here": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^https://[^\\s]+$"
      }
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    }
  }
}
