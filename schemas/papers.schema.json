{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resourcehub.net/schemas/papers.schema.json",
  "title": "resourcehub.net papers entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "authors",
    "date",
    "link",
    "takeaway",
    "why_it_matters",
    "key_result",
    "publication",
    "claim",
    "code",
    "tags"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}){0,2}$"
    },
    "link": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "description": "The canonical arXiv, DOI or publisher page, never a post about it."
    },
    "takeaway": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "why_it_matters": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "key_result": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "publication": {
      "type": "string",
      "enum": [
        "peer-reviewed",
        "preprint",
        "other"
      ]
    },
    "claim": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "hype",
        "opinion"
      ],
      "description": "How far the entry's central claim is checked: verified against the primary source, or a secondhand claim labelled unverified, hype or opinion."
    },
    "code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://[^\\s]+$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
      }
    }
  }
}
