{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resourcehub.net/schemas/common.schema.json",
  "title": "resourcehub.net common entry fields",
  "type": "object",
  "description": "Fields every entry carries, merged into each section schema by build.py.",
  "required": [
    "id",
    "section",
    "added",
    "reviewed_by",
    "sources",
    "agent_written"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,80}$",
      "description": "Equals the file name without .json."
    },
    "section": {
      "type": "string",
      "enum": [
        "papers",
        "people",
        "repos",
        "demos"
      ]
    },
    "added": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date the entry was published."
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://[^\\s]+$"
      },
      "description": "Public URLs the entry was written from."
    },
    "agent_written": {
      "type": "boolean"
    }
  }
}
