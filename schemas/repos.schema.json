{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resourcehub.net/schemas/repos.schema.json",
  "title": "resourcehub.net repos entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo",
    "url",
    "license",
    "language",
    "stars_at_review",
    "pushed",
    "what_it_is",
    "reviewed",
    "focus",
    "focus_reason",
    "measured_against",
    "reviewed_on",
    "last_commit",
    "releases_last_year",
    "latest_release",
    "open_issues",
    "tests_ci",
    "does_not_do"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "stars_at_review": {
      "type": "integer",
      "minimum": 0
    },
    "pushed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "what_it_is": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "reviewed": {
      "const": true
    },
    "focus": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "How much attention it earns against the stated need; not praise."
    },
    "focus_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "measured_against": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "reviewed_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_commit": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of the newest commit on the default branch at review."
    },
    "releases_last_year": {
      "type": "integer",
      "minimum": 0,
      "description": "Published releases in the 365 days before reviewed_on: the release cadence."
    },
    "latest_release": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120,
      "description": "Newest release tag and its date, or null when the project publishes none."
    },
    "open_issues": {
      "type": "integer",
      "minimum": 0,
      "description": "Open issues (not pull requests) at review."
    },
    "tests_ci": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "Whether tests and CI are present, as found in the repository."
    },
    "does_not_do": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "description": "What it does not do, against the stated need."
    }
  }
}
